# ═══════════════════════════════════════════════════════════════════════════════
# NokiaMSN — plantilla de configuración
# Copia este fichero a .env y rellena los valores:   cp .env.example .env
# El .env NO se sube a git (contiene secretos).
#
# Ojo: algunas opciones (SMS, ticks azules, limpieza y días de retención) también se
# cambian desde la pantalla «Ajustes» del Nokia, y la app reescribe este fichero.
# Es normal que el .env cambie solo.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Servidor ────────────────────────────────────────────────────────────────────
# Puerto HTTP interno. Con el stack de GateWayNK se fuerza a 3001 desde el compose.
PORT=8080

# Ruta de la base de datos SQLite (las fotos de perfil y los certificados TLS se guardan
# junto a ella, en avatars/ y tls/). En Docker ya viene fijada a /data/nokia.db; solo
# hace falta tocarla si arrancas con «npm start» fuera de Docker.
# DB_PATH=./data/nokia.db

# ── Seguridad (PIN de acceso desde el Nokia) — OBLIGATORIO ─────────────────────
# Hash bcrypt del PIN. Sin él no se puede entrar. Para generarlo:
#   node -e "console.log(require('bcryptjs').hashSync('TUPIN', 10));"
# Escríbelo entre comillas simples: el hash lleva «$» y si no se rompe.
ACCESS_PIN_HASH_BCRYPT='$2b$10$cambia.esto.por.el.hash.de.tu.pin.................'

# Días que se recuerda una IP como dispositivo de confianza al marcar «Recordar».
REMEMBER_DEVICE_DAYS=30

# ── WhatsApp ────────────────────────────────────────────────────────────────────
# Opcional: tu número con prefijo de país (solo dígitos, p. ej. 34600111222).
# Permite vincular con código de 8 caracteres desde /qr en vez de escanear el QR.
WHATSAPP_PAIRING_PHONE=

# Envía el «visto» (doble tick azul) al abrir un chat con mensajes sin leer.
SEND_READ_RECEIPTS_ENABLED=false

# ── Dirección pública ──────────────────────────────────────────────────────────
# URL pública HTTP (dominio estático de ngrok). NokiaMSN solo la usa para los enlaces
# de los SMS cuando no hay túnel HTTPS activo. El túnel en sí se configura en
# GateWayNK/Gateway/.env (NGROK_AUTHTOKEN, NGROK_HTTP_URL), no aquí.
NGROK_HTTP_URL=https://tu-dominio.ngrok-free.app

# ── Limpieza diaria de privacidad ──────────────────────────────────────────────
# A las 02:00 (hora de Madrid) borra los mensajes con esta antigüedad en días o más,
# y después los usuarios y grupos que se queden sin mensajes. 'false' la desactiva.
DAILY_CLEANUP_ENABLED=true
MESSAGE_RETENTION_DAYS=3

# ── Notificaciones SMS (Twilio) ────────────────────────────────────────────────
# Manda un SMS al Nokia cuando entra un mensaje con el buzón a 0 (y por cada llamada
# de WhatsApp). El watchdog de GateWayNK reutiliza estas credenciales para avisar
# de caídas. Cada SMS cuesta dinero en Twilio.
SMS_NOTIFICATIONS_ENABLED=false
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+10000000000
TWILIO_TO_NUMBER=+34600000000
# Segundos que se considera que estás «usando» NokiaMSN tras una petición del Nokia
# (mientras tanto no se mandan SMS de mensajes nuevos).
# SMS_ACTIVE_WINDOW_SECONDS=15

# ── Notas de voz ───────────────────────────────────────────────────────────────
# Veces que se puede abrir un audio en el Nokia (DRM OMA 1.0, count). 0 quita la
# protección y se descarga como .amr normal.
AUDIO_PLAY_COUNT=1

# ── Transcripción de audios (Groq / Whisper) ───────────────────────────────────
# Clave gratuita en https://console.groq.com. Sin ella no se transcribe nada.
GROQ_API_KEY=

# 1 = adapta el catalán al valenciano (sortir→eixir, aquest→este, avui→hui…)
# 0 = deja el texto tal cual lo devuelve Whisper.
VALENCIANIZAR=1

# Nombres propios y palabras que Whisper escribe mal, separados por comas.
# Máximo ~30 palabras: va dentro del prompt de Whisper.
VOCAB=

# Umbral de silencio (dB) para trocear el audio por pausas. Si con ruido de fondo
# todo sale en un solo trozo, súbelo a -30 o -28.
SILENCIO_DB=-35

# ── Integración con GateWayNK (normalmente no hace falta tocarlo) ──────────────
# WATCHDOG_URL=http://watchdog:8090/api/status
# TRUSTED_DEVICES_FILE=/data/trusted_devices.json
